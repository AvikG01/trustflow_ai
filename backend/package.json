{
  "name": "trustflow-ai-backend",
  "version": "1.0.0",
  "description": "Production-oriented backend for TrustFlow AI - AI-powered resume building, ATS/CCS analysis, job discovery and resume optimization platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/**/*.test.js",
    "db:create": "node database/createDatabase.js",
    "db:migrate": "node database/migrationRunner.js",
    "db:status": "node database/migrationStatus.js",
    "db:verify": "node database/verifyDatabase.js",
    "db:seed": "node database/seedDatabase.js",
    "db:setup": "node database/setupDatabase.js",
    "db:test": "node database/testConnection.js",
    "db:init": "node src/database/initDb.js"
  },
  "keywords": [
    "trustflow-ai",
    "resume-builder",
    "ats-analysis",
    "ccs-analysis",
    "gemini-ai",
    "express",
    "mysql"
  ],
  "author": "TrustFlow AI Engineering",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "nodemon": "^3.1.14",
    "pdf-parse": "^1.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
